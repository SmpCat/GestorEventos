// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// MODELO GLOBAL
// ---------------------------------------------------------

model User {
  id             String          @id @default(uuid())
  name           String
  username       String          @unique
  password       String
  email          String?
  phone          String?
  isAdmin        Boolean         @default(false)
  isMember       Boolean         @default(true)  // ¿Es socio/a de la peña? (Por defecto Sí)
  age            Int?                            // Edad del usuario
  canUploadTickets Boolean       @default(true)  // ¿Puede subir tickets de compra? (Por defecto Sí)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relaciones
  eventAttendances EventAttendee[]
  expenses         Expense[]
  assignedShoppingLists ShoppingList[] @relation("ShoppingListAssignee") // Listas asignadas al usuario
  
  // Auditoría
  registeredPayments       Payment[]           @relation("PaymentRegisteredBy")
  shoppingHistoryChanges   ShoppingListHistory[] @relation("ShoppingHistoryUser")
}

// ---------------------------------------------------------
// MODELOS ESPECÍFICOS POR EVENTO (MULTI-TENANT)
// ---------------------------------------------------------

model Event {
  id          String   @id @default(uuid())
  name        String   // ej. "Fiestas Valdeganga 2026"
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(false) // Solo UNO puede ser true
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  attendees       EventAttendee[]
  pricingRules    PricingRule[]
  expenses        Expense[]
  shoppingLists   ShoppingList[]
  shoppingEvidences ShoppingListEvidence[]
  payments        Payment[]
}

model EventAttendee {
  id            String   @id @default(uuid())
  daysAttending Int      @default(0)
  balance       Float    @default(0.0) // Saldo a favor en ESTE evento
  
  drinkOption   String   @default("CON_ALCOHOL") // "CON_ALCOHOL" | "SIN_ALCOHOL" | "NO_BEBIDA"
  eatFood       Boolean  @default(true)           // true = Sí Comida, false = No Comida

  // Custom Pricing (Nuevos campos)
  expectedPayment Float?   // Lo que tiene que pagar. Nulo = automático según tabla.
  adminComment    String?  // Comentario del admin si sobrescribe el precio.
  
  // Relaciones
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Un usuario solo puede asistir una vez a un mismo evento
  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])

  // Pagos realizados por el asistente
  payments      Payment[]
}

model Payment {
  id          String   @id @default(uuid())
  amount      Float
  type        String   @default("INCOME") // "INCOME" o "EXPENSE"
  description String?
  date        DateTime @default(now())
  
  // Relación con el Evento (Requerida)
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Relación con el Asistente (Opcional)
  attendeeId  String?
  attendee    EventAttendee? @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  // Auditoría
  registeredById String?
  registeredBy   User?   @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])

  @@index([eventId])
  @@index([attendeeId])
  @@index([registeredById])
}

model PricingRule {
  id            String   @id @default(uuid())
  name          String?  // ej. "Socio Adulto (1 día)"
  days          Int      // 1, 2, 3 (o más) (Días mínimos)
  maxDays       Int?     // Días máximos (inclusive, null = sin límite)
  price         Float
  
  // Filtros condicionales (opcionales: null = aplica a todos)
  isMember      Boolean? // true = solo socios, false = solo no socios, null = todos
  minAge        Int?     // edad mínima (inclusive)
  maxAge        Int?     // edad máxima (inclusive)
  drinkOption   String?  // "CON_ALCOHOL" | "SIN_ALCOHOL" | "NO_BEBIDA" | null = todos
  eatFood       Boolean? // true = solo come, false = solo no come, null = todos
  
  // Relaciones
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ShoppingList {
  id          String   @id @default(uuid())
  name        String   // ej. "Bebidas a comprar"
  
  // Relación con el Evento
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Asistente asignado a TODA la lista (Opcional)
  assigneeId  String?
  assignee    User?    @relation("ShoppingListAssignee", fields: [assigneeId], references: [id])

  // Foto/Evidencia manuscrita vinculada a esta lista (Opcional)
  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Productos pertenecientes a esta lista
  items       ShoppingListItem[]

  @@index([eventId])
  @@index([assigneeId])
}

model ShoppingListItem {
  id          String   @id @default(uuid())
  name        String   // ej. "100 cervezas"
  isPurchased Boolean  @default(false)
  
  // Relación con la Lista padre
  listId      String
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  
  // Vinculado al ticket final cuando ya se ha comprado (Opcional)
  expenseItemId String? @unique
  expenseItem   ExpenseItem? @relation(fields: [expenseItemId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Historial de cambios
  history     ShoppingListHistory[]

  @@index([listId])
}

model ShoppingListEvidence {
  id        String   @id @default(uuid())
  url       String   // Ruta física o URL de la imagen
  isScanned Boolean  @default(true)
  createdAt DateTime @default(now())
  
  // Relaciones
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Expense {
  id           String   @id @default(uuid())
  description  String
  store        String
  amount       Float
  date         DateTime @default(now())
  isScanned    Boolean  @default(true)
  
  // Relaciones
  purchaserId  String
  purchaser    User     @relation(fields: [purchaserId], references: [id])
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Soporte para tickets muy largos e inventario de productos (Extraídos por IA)
  images       ExpenseImage[]
  items        ExpenseItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
  @@index([purchaserId])
}

model ExpenseImage {
  id        String   @id @default(uuid())
  url       String   // Ruta de la imagen (o varias si el ticket es largo)
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model ExpenseItem {
  id        String   @id @default(uuid())
  name      String   // Nombre del producto (ej. "Cerveza Alhambra")
  price     Float    // Precio del producto
  quantity  Int      @default(1)
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  
  // Relación inversa con la lista de la compra
  shoppingListItem ShoppingListItem?

  @@index([expenseId])
}

// ---------------------------------------------------------
// MODELOS DE AUDITORÍA Y REGISTRO
// ---------------------------------------------------------

model ShoppingListHistory {
  id                 String   @id @default(uuid())
  shoppingListItemId String
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  
  action             String   // "CREATED", "PURCHASED", "UNPURCHASED"
  
  // Usuario que hizo el cambio
  userId             String
  user               User     @relation("ShoppingHistoryUser", fields: [userId], references: [id])
  
  date               DateTime @default(now())

  @@index([shoppingListItemId])
  @@index([userId])
}

model SystemConfig {
  id                  String   @id @default("global")
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?  @default("Estamos realizando labores de mantenimiento y optimización. Volveremos muy pronto.")
  disableTicketUpload Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
